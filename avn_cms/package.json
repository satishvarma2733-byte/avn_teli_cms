{
  "name": "avn-cms",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "aVn CMS — multi-tenant educational CRM/CMS",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @avn-cms/web dev",
    "dev:worker": "pnpm --filter @avn-cms/worker dev",
    "build": "pnpm db:generate && pnpm --filter @avn-cms/web build",
    "start": "pnpm --filter @avn-cms/web start",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "pnpm db:generate && pnpm -r --parallel typecheck",
    "test": "vitest run --project unit && vitest run --project integration",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "pnpm build && playwright test --config tests/e2e/playwright.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "stack:up": "docker compose -f docker-compose.yml up -d --wait",
    "stack:down": "docker compose -f docker-compose.yml down",
    "db:generate": "pnpm --filter @avn-cms/db generate",
    "db:migrate": "pnpm --filter @avn-cms/db migrate:deploy",
    "db:migrate:dev": "pnpm --filter @avn-cms/db migrate:dev",
    "db:seed": "pnpm --filter @avn-cms/db seed",
    "db:reset:test": "pnpm --filter @avn-cms/db reset:test",
    "smoke:webleads": "tsx scripts/smoke-webleads.ts",
    "test:e2e:only": "playwright test --config tests/e2e/playwright.config.ts",
    "admin:create-superadmin": "tsx scripts/create-superadmin.ts",
    "storage:setup": "tsx scripts/storage-setup.ts"
  },
  "devDependencies": {
    "@avn-cms/auth": "workspace:*",
    "@avn-cms/config": "workspace:*",
    "@avn-cms/core": "workspace:*",
    "@avn-cms/db": "workspace:*",
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.0.0",
    "bullmq": "6.3.9",
    "eslint": "^10.11.0",
    "exceljs": "^4.4.0",
    "globals": "^16.0.0",
    "ioredis": "^6.0.0",
    "next": "16.3.8",
    "prettier": "^3.9.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.20.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "prisma",
      "esbuild",
      "@node-rs/argon2",
      "sharp",
      "@tailwindcss/oxide"
    ],
    "overrides": {
      "deepmerge-ts": "^8.0.2",
      "mysql2": "^3.24.6",
      "exceljs>uuid": "^11.1.1"
    }
  }
}
