# aVn CMS server configuration. Copy to .env for local development.
# Every value is read and validated once in packages/config; nothing reads process.env elsewhere.
# Never put secrets in NEXT_PUBLIC_* variables.

NODE_ENV=development
APP_URL=http://localhost:3300

# Application role: row-level security applies (tenant data).
DATABASE_URL=postgresql://avn_app:avn_app_local_only@127.0.0.1:55450/avn_cms
# Owner role: migrations, auth lookups, super-admin. Bypasses RLS — server-only.
DATABASE_OWNER_URL=postgresql://avn_owner:avn_owner_local_only@127.0.0.1:55450/avn_cms

# Test databases (used only by the test runner).
TEST_DATABASE_URL=postgresql://avn_app:avn_app_local_only@127.0.0.1:55450/avn_cms_test
TEST_DATABASE_OWNER_URL=postgresql://avn_owner:avn_owner_local_only@127.0.0.1:55450/avn_cms_test

# Rate limits and the job queue. While it is set, imports and exports wait for the worker (pnpm dev:worker);
# empty runs them inside the web process (development only).
REDIS_URL=redis://127.0.0.1:16390
# Redis for the queue test (tests/integration/bullmq-jobs.int.test.ts). It must name a database other
# than 0, because the test empties it. Optional: this is the default.
TEST_REDIS_URL=redis://127.0.0.1:16390/15

# 32+ random bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=
# Encrypts MFA secrets at rest. Same format as SESSION_SECRET, a different value.
ENCRYPTION_KEY=

# Outgoing email (local: Mailpit at http://127.0.0.1:58125).
SMTP_HOST=127.0.0.1
SMTP_PORT=51125
SMTP_USER=
SMTP_PASS=
SMTP_FROM="aVn CMS <no-reply@avn-cms.local>"

# Documents vault. Production: Cloudflare R2 (S3 API). Create a private bucket and an API token with
# Object Read & Write on it, then set R2_ACCOUNT_ID, R2_BUCKET, R2_ACCESS_KEY_ID and
# R2_SECRET_ACCESS_KEY, and leave R2_ENDPOINT out. See docs/DOCUMENTS.md for the CORS rules.
# Local: the MinIO container from docker-compose.yml (credentials are local-only).
R2_ENDPOINT=http://127.0.0.1:19000
R2_BUCKET=avn-documents
R2_ACCESS_KEY_ID=avn_minio
R2_SECRET_ACCESS_KEY=avn_minio_local_only
# Test runs use their own bucket so they never touch development files.
TEST_R2_BUCKET=avn-documents-test
# Antivirus (clamd). Without it uploaded documents stay unavailable. Local: the clamav container.
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=33100

# Session lifetime in hours (idle sessions expire sooner; see packages/auth).
SESSION_TTL_HOURS=168

# Password for the demo users created by `pnpm db:seed` (TEST DATA ONLY; local development).
SEED_PASSWORD=Demo-Password-2026
