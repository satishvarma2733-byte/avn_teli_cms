// aVn CMS database schema. Contract: docs/DATABASE_SCHEMA.md.
// Conventions: UUID keys, snake_case tables/columns, timestamptz, tenant_id on every
// tenant-owned table (RLS policies and partial indexes live in the SQL migrations).

generator client {
  provider            = "prisma-client"
  output              = "../generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

// ── Enums ────────────────────────────────────────────────────────────────────

enum TenantStatus {
  ACTIVE
  SUSPENDED
  TRIAL

  @@map("tenant_status")
}

enum RoleCode {
  SUPER_ADMIN
  TENANT_ADMIN
  COUNSELOR
  TELECALLER

  @@map("role_code")
}

enum UserStatus {
  ACTIVE
  DISABLED

  @@map("user_status")
}

enum PlanCode {
  STARTER
  PROFESSIONAL
  ULTRA
  ENTERPRISE

  @@map("plan_code")
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED

  @@map("subscription_status")
}

enum LeadStage {
  NEW
  CONTACTED
  INTERESTED
  FOLLOW_UP_REQUIRED
  POTENTIAL
  APPLICATION_STARTED
  DOCUMENTS_PENDING
  APPLICATION_SUBMITTED
  OFFER_RECEIVED
  ADMISSION_CONFIRMED
  ENROLLED
  NOT_INTERESTED
  INVALID
  UNREACHABLE
  DUPLICATE
  BLOCKED
  LOST
  LONG_TERM

  @@map("lead_stage")
}

enum CallDisposition {
  SCHEDULED
  COMPLETED
  NO_ANSWER
  BUSY
  SWITCHED_OFF
  CALL_BACK_LATER
  INTERESTED
  NOT_INTERESTED
  AWAITING_FEEDBACK
  ESCALATED

  @@map("call_disposition")
}

enum Priority {
  NORMAL
  HOT

  @@map("priority")
}

enum RoleFunction {
  COUNSELOR
  TELECALLER

  @@map("role_function")
}

enum ActivityType {
  CALL
  WHATSAPP
  EMAIL
  SMS
  NOTE
  STATUS_CHANGE
  ASSIGNMENT
  DOCUMENT
  SYSTEM

  @@map("activity_type")
}

enum Direction {
  IN
  OUT

  @@map("direction")
}

enum WebLeadStatus {
  NEW
  DUPLICATE
  CONVERTED
  SPAM
  REJECTED

  @@map("web_lead_status")
}

enum IntakeChannel {
  PUBLIC_API
  WEBHOOK
  LEADXP_COMPAT
  IMPORT

  @@map("intake_channel")
}

enum ScanStatus {
  PENDING
  CLEAN
  INFECTED

  @@map("scan_status")
}

enum StudentDocType {
  PASSPORT
  MARKS_MEMO
  NEET_RESULT
  TRANSFER_CERT
  PHOTO
  ADMISSION_LETTER
  VISA
  PAYMENT_RECEIPT
  OTHER

  @@map("student_doc_type")
}

enum StudentDocStatus {
  MISSING
  UPLOADED
  VERIFIED
  REJECTED

  @@map("student_doc_status")
}

enum JobStatus {
  QUEUED
  RUNNING
  DONE
  FAILED

  @@map("job_status")
}

enum AutomationTrigger {
  WEB_LEAD_CREATED
  LEAD_UNCONTACTED
  FOLLOWUP_OVERDUE
  STAGE_CHANGED

  @@map("automation_trigger")
}

// ── Platform ─────────────────────────────────────────────────────────────────

model Plan {
  id           String         @id @default(uuid()) @db.Uuid
  code         PlanCode       @unique
  name         String
  limits       Json           @default("{}")
  priceMinor   Int            @default(0) @map("price_minor")
  currency     String         @default("INR") @db.Char(3)
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  tenants      Tenant[]
  subscriptions Subscription[]

  @@map("plans")
}

model Role {
  id   String   @id @default(uuid()) @db.Uuid
  code RoleCode @unique
  name String

  @@map("roles")
}

model Tenant {
  id        String       @id @default(uuid()) @db.Uuid
  name      String
  slug      String       @unique
  status    TenantStatus @default(TRIAL)
  planId    String?      @map("plan_id") @db.Uuid
  plan      Plan?        @relation(fields: [planId], references: [id])
  settings  Json         @default("{}")
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  users             User[]
  students          Student[]
  leads             Lead[]
  leadSources       LeadSource[]
  webLeads          WebLead[]
  intakeCredentials IntakeCredential[]
  subscriptions     Subscription[]
  auditLogs         AuditLog[]

  @@map("tenants")
}

model Subscription {
  id          String             @id @default(uuid()) @db.Uuid
  tenantId    String             @map("tenant_id") @db.Uuid
  tenant      Tenant             @relation(fields: [tenantId], references: [id])
  planId      String             @map("plan_id") @db.Uuid
  plan        Plan               @relation(fields: [planId], references: [id])
  status      SubscriptionStatus @default(ACTIVE)
  periodStart DateTime           @map("period_start") @db.Timestamptz(6)
  periodEnd   DateTime           @map("period_end") @db.Timestamptz(6)
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([tenantId])
  @@map("subscriptions")
}

model UsageCounter {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  metric   String
  period   String
  value    BigInt @default(0)

  @@unique([tenantId, metric, period])
  @@map("usage_counters")
}

// ── Identity ─────────────────────────────────────────────────────────────────

model User {
  id                String     @id @default(uuid()) @db.Uuid
  /// Null only for SUPER_ADMIN (platform user).
  tenantId          String?    @map("tenant_id") @db.Uuid
  tenant            Tenant?    @relation(fields: [tenantId], references: [id])
  roleCode          RoleCode   @map("role_code")
  name              String
  email             String     @db.Citext
  phoneE164         String?    @map("phone_e164")
  passwordHash      String     @map("password_hash")
  status            UserStatus @default(ACTIVE)
  /// TOTP secret, AES-256-GCM encrypted (packages/auth).
  mfaSecret         String?    @map("mfa_secret")
  mfaEnabledAt      DateTime?  @map("mfa_enabled_at") @db.Timestamptz(6)
  lastLoginAt       DateTime?  @map("last_login_at") @db.Timestamptz(6)
  failedLoginCount  Int        @default(0) @map("failed_login_count")
  lockedUntil       DateTime?  @map("locked_until") @db.Timestamptz(6)
  lastRoundRobinAt  DateTime?  @map("last_round_robin_at") @db.Timestamptz(6)
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt         DateTime?  @map("deleted_at") @db.Timestamptz(6)

  sessions        Session[]
  resetTokens     PasswordResetToken[]
  assignments     LeadAssignment[]     @relation("assignee")
  followUps       FollowUp[]           @relation("followup_assignee")

  // UNIQUE NULLS NOT DISTINCT (tenant_id, email) is created in SQL (migration 0001).
  @@index([tenantId, roleCode, status])
  @@map("users")
}

model Session {
  id                    String    @id @default(uuid()) @db.Uuid
  userId                String    @map("user_id") @db.Uuid
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// SHA-256 of the opaque cookie token; the token itself is never stored.
  tokenHash             String    @unique @map("token_hash")
  /// Per-session CSRF secret (double-submit token is derived from it).
  csrfSecret            String    @map("csrf_secret")
  /// false until the second factor is checked for an MFA-enabled user.
  mfaVerified           Boolean   @default(true) @map("mfa_verified")
  /// Super-admin impersonation: the tenant being acted as (audited).
  actingTenantId        String?   @map("acting_tenant_id") @db.Uuid
  ip                    String?
  userAgent             String?   @map("user_agent")
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSeenAt            DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  expiresAt             DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt             DateTime? @map("revoked_at") @db.Timestamptz(6)

  @@index([userId, revokedAt])
  @@map("sessions")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId])
  @@map("password_reset_tokens")
}

// ── CRM core ─────────────────────────────────────────────────────────────────

model LeadSource {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  code     String
  label    String
  isActive Boolean @default(true) @map("is_active")

  leads    Lead[]
  webLeads WebLead[]

  @@unique([tenantId, code])
  @@map("lead_sources")
}

/// The person. Dedupe key: UNIQUE(tenant_id, phone_e164) WHERE deleted_at IS NULL (SQL).
model Student {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  tenant       Tenant    @relation(fields: [tenantId], references: [id])
  name         String
  parentName   String?   @map("parent_name")
  phoneRaw     String    @map("phone_raw")
  phoneE164    String    @map("phone_e164")
  altPhoneE164 String?   @map("alt_phone_e164")
  email        String?   @db.Citext
  town         String?
  district     String?
  state        String?
  address      String?
  createdById  String?   @map("created_by_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(6)

  leads      Lead[]
  activities Activity[]
  documents  StudentDocument[]

  @@index([tenantId, phoneE164])
  @@index([tenantId, email])
  @@index([tenantId, state, district])
  @@index([tenantId, createdAt(sort: Desc), id])
  @@map("students")
}

/// The opportunity.
model Lead {
  id              String     @id @default(uuid()) @db.Uuid
  tenantId        String     @map("tenant_id") @db.Uuid
  tenant          Tenant     @relation(fields: [tenantId], references: [id])
  studentId       String     @map("student_id") @db.Uuid
  student         Student    @relation(fields: [studentId], references: [id])
  sourceId        String     @map("source_id") @db.Uuid
  source          LeadSource @relation(fields: [sourceId], references: [id])
  stage           LeadStage  @default(NEW)
  isPotential     Boolean    @default(false) @map("is_potential")
  priority        Priority   @default(NORMAL)
  interestCountry String?    @map("interest_country")
  interestCourse  String?    @map("interest_course")
  nextCallAt      DateTime?  @map("next_call_at") @db.Timestamptz(6)
  lastContactedAt DateTime?  @map("last_contacted_at") @db.Timestamptz(6)
  lostReason      String?    @map("lost_reason")
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime?  @map("deleted_at") @db.Timestamptz(6)

  assignments   LeadAssignment[]
  followUps     FollowUp[]
  statusHistory LeadStatusHistory[]
  notes         Note[]
  activities    Activity[]

  @@index([tenantId, stage])
  @@index([tenantId, createdAt(sort: Desc), id])
  @@index([tenantId, studentId])
  @@index([tenantId, sourceId])
  @@index([tenantId, nextCallAt])
  @@map("leads")
}

/// One active row per (lead, role_function): partial unique index in SQL.
model LeadAssignment {
  id           String       @id @default(uuid()) @db.Uuid
  tenantId     String       @map("tenant_id") @db.Uuid
  leadId       String       @map("lead_id") @db.Uuid
  lead         Lead         @relation(fields: [leadId], references: [id])
  assigneeId   String       @map("assignee_id") @db.Uuid
  assignee     User         @relation("assignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  roleFunction RoleFunction @map("role_function")
  assignedById String?      @map("assigned_by_id") @db.Uuid
  assignedAt   DateTime     @default(now()) @map("assigned_at") @db.Timestamptz(6)
  isActive     Boolean      @default(true) @map("is_active")
  endedAt      DateTime?    @map("ended_at") @db.Timestamptz(6)

  @@index([tenantId, assigneeId, isActive])
  @@index([tenantId, leadId])
  @@map("lead_assignments")
}

model LeadStatusHistory {
  id          String     @id @default(uuid()) @db.Uuid
  tenantId    String     @map("tenant_id") @db.Uuid
  leadId      String     @map("lead_id") @db.Uuid
  lead        Lead       @relation(fields: [leadId], references: [id])
  fromStage   LeadStage? @map("from_stage")
  toStage     LeadStage  @map("to_stage")
  changedById String?    @map("changed_by_id") @db.Uuid
  note        String?
  reason      String?
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([tenantId, leadId, createdAt])
  @@index([tenantId, toStage, createdAt])
  @@map("lead_status_history")
}

model FollowUp {
  id           String          @id @default(uuid()) @db.Uuid
  tenantId     String          @map("tenant_id") @db.Uuid
  leadId       String          @map("lead_id") @db.Uuid
  lead         Lead            @relation(fields: [leadId], references: [id])
  scheduledAt  DateTime        @map("scheduled_at") @db.Timestamptz(6)
  assigneeId   String          @map("assignee_id") @db.Uuid
  assignee     User            @relation("followup_assignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  disposition  CallDisposition @default(SCHEDULED)
  priority     Priority        @default(NORMAL)
  outcomeNote  String?         @map("outcome_note")
  completedAt  DateTime?       @map("completed_at") @db.Timestamptz(6)
  isOverdue    Boolean         @default(false) @map("is_overdue")
  escalatedTo  String?         @map("escalated_to") @db.Uuid
  escalatedAt  DateTime?       @map("escalated_at") @db.Timestamptz(6)
  createdById  String?         @map("created_by_id") @db.Uuid
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([tenantId, assigneeId, scheduledAt])
  @@index([tenantId, leadId])
  @@map("follow_ups")
}

/// Append-only timeline.
model Activity {
  id        String       @id @default(uuid()) @db.Uuid
  tenantId  String       @map("tenant_id") @db.Uuid
  leadId    String?      @map("lead_id") @db.Uuid
  lead      Lead?        @relation(fields: [leadId], references: [id])
  studentId String       @map("student_id") @db.Uuid
  student   Student      @relation(fields: [studentId], references: [id])
  type      ActivityType
  actorId   String?      @map("actor_id") @db.Uuid
  channel   String?
  direction Direction?
  summary   String
  payload   Json         @default("{}")
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([tenantId, studentId, createdAt(sort: Desc)])
  @@index([tenantId, leadId, createdAt(sort: Desc)])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("activities")
}

model Note {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  leadId    String   @map("lead_id") @db.Uuid
  lead      Lead     @relation(fields: [leadId], references: [id])
  authorId  String?  @map("author_id") @db.Uuid
  body      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([tenantId, leadId, createdAt])
  @@map("notes")
}

// ── Intake ───────────────────────────────────────────────────────────────────

model IntakeCredential {
  id                    String    @id @default(uuid()) @db.Uuid
  tenantId              String    @map("tenant_id") @db.Uuid
  tenant                Tenant    @relation(fields: [tenantId], references: [id])
  name                  String
  username              String    @unique
  secretHash            String    @map("secret_hash")
  previousSecretHash    String?   @map("previous_secret_hash")
  previousValidUntil    DateTime? @map("previous_valid_until") @db.Timestamptz(6)
  defaultSourceId       String?   @map("default_source_id") @db.Uuid
  rateLimitPerMin       Int       @default(120) @map("rate_limit_per_min")
  lastUsedAt            DateTime? @map("last_used_at") @db.Timestamptz(6)
  useCount              BigInt    @default(0) @map("use_count")
  createdById           String?   @map("created_by_id") @db.Uuid
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  revokedAt             DateTime? @map("revoked_at") @db.Timestamptz(6)

  webLeads WebLead[]

  @@index([tenantId])
  @@map("intake_credentials")
}

model WebLead {
  id                    String            @id @default(uuid()) @db.Uuid
  tenantId              String            @map("tenant_id") @db.Uuid
  tenant                Tenant            @relation(fields: [tenantId], references: [id])
  name                  String
  phoneRaw              String            @map("phone_raw")
  phoneE164             String?           @map("phone_e164")
  email                 String?           @db.Citext
  interestCountry       String?           @map("interest_country")
  interestCourse        String?           @map("interest_course")
  message               String?
  sourceId              String?           @map("source_id") @db.Uuid
  source                LeadSource?       @relation(fields: [sourceId], references: [id])
  sourceLabel           String?           @map("source_label")
  submittedAt           DateTime          @default(now()) @map("submitted_at") @db.Timestamptz(6)
  status                WebLeadStatus     @default(NEW)
  dedupeMatchStudentId  String?           @map("dedupe_match_student_id") @db.Uuid
  convertedLeadId       String?           @map("converted_lead_id") @db.Uuid
  rawPayload            Json              @default("{}") @map("raw_payload")
  intakeChannel         IntakeChannel     @default(PUBLIC_API) @map("intake_channel")
  intakeCredentialId    String?           @map("intake_credential_id") @db.Uuid
  intakeCredential      IntakeCredential? @relation(fields: [intakeCredentialId], references: [id])
  city                  String?
  neetScore             Int?              @map("neet_score")
  neetStatus            String?           @map("neet_status")
  education             String?
  educationGroup        String?           @map("education_group")
  submittedBy           String?           @map("submitted_by")
  postSlug              String?           @map("post_slug")
  gclid                 String?
  campaignId            String?           @map("campaign_id")
  pageUrl               String?           @map("page_url")
  landingPage           String?           @map("landing_page")
  utmSource             String?           @map("utm_source")
  utmMedium             String?           @map("utm_medium")
  utmCampaign           String?           @map("utm_campaign")
  utmTerm               String?           @map("utm_term")
  utmContent            String?           @map("utm_content")
  formId                String?           @map("form_id")
  sessionId             String?           @map("session_id")
  qualityFlags          String[]          @default([]) @map("quality_flags")
  idempotencyKey        String?           @map("idempotency_key")
  reviewedById          String?           @map("reviewed_by_id") @db.Uuid
  reviewedAt            DateTime?         @map("reviewed_at") @db.Timestamptz(6)
  createdAt             DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([tenantId, status, submittedAt(sort: Desc)])
  @@index([tenantId, phoneE164])
  @@index([tenantId, utmCampaign])
  @@index([tenantId, sourceLabel])
  @@map("web_leads")
}

// ── Documents ────────────────────────────────────────────────────────────────

model Folder {
  id          String     @id @default(uuid()) @db.Uuid
  tenantId    String     @map("tenant_id") @db.Uuid
  name        String
  parentId    String?    @map("parent_id") @db.Uuid
  createdById String?    @map("created_by_id") @db.Uuid
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt   DateTime?  @map("deleted_at") @db.Timestamptz(6)
  documents   Document[]

  @@index([tenantId, parentId])
  @@map("folders")
}

model Document {
  id           String     @id @default(uuid()) @db.Uuid
  tenantId     String     @map("tenant_id") @db.Uuid
  folderId     String?    @map("folder_id") @db.Uuid
  folder       Folder?    @relation(fields: [folderId], references: [id])
  studentId    String?    @map("student_id") @db.Uuid
  filename     String
  mimeType     String     @map("mime_type")
  sizeBytes    BigInt     @map("size_bytes")
  storageKey   String     @map("storage_key")
  scanStatus   ScanStatus @default(PENDING) @map("scan_status")
  version      Int        @default(1)
  uploadedById String?    @map("uploaded_by_id") @db.Uuid
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt    DateTime?  @map("deleted_at") @db.Timestamptz(6)

  @@index([tenantId, folderId])
  @@index([tenantId, studentId])
  @@map("documents")
}

model StudentDocument {
  id           String           @id @default(uuid()) @db.Uuid
  tenantId     String           @map("tenant_id") @db.Uuid
  studentId    String           @map("student_id") @db.Uuid
  student      Student          @relation(fields: [studentId], references: [id])
  docType      StudentDocType   @map("doc_type")
  documentId   String?          @map("document_id") @db.Uuid
  status       StudentDocStatus @default(MISSING)
  reviewedById String?          @map("reviewed_by_id") @db.Uuid
  note         String?
  updatedAt    DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([tenantId, studentId, docType])
  @@map("student_documents")
}

// ── Jobs, notifications, automation, audit ───────────────────────────────────

model ImportJob {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  requestedById String    @map("requested_by_id") @db.Uuid
  type          String
  status        JobStatus @default(QUEUED)
  params        Json      @default("{}")
  result        Json      @default("{}")
  fileKey       String?   @map("file_key")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  finishedAt    DateTime? @map("finished_at") @db.Timestamptz(6)

  @@index([tenantId, createdAt(sort: Desc)])
  @@map("import_jobs")
}

model ExportJob {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  requestedById String    @map("requested_by_id") @db.Uuid
  type          String
  status        JobStatus @default(QUEUED)
  params        Json      @default("{}")
  result        Json      @default("{}")
  fileKey       String?   @map("file_key")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  finishedAt    DateTime? @map("finished_at") @db.Timestamptz(6)

  @@index([tenantId, createdAt(sort: Desc)])
  @@map("export_jobs")
}

model Notification {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  type       String
  title      String
  body       String?
  entityType String?   @map("entity_type")
  entityId   String?   @map("entity_id") @db.Uuid
  readAt     DateTime? @map("read_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([tenantId, userId, readAt, createdAt(sort: Desc)])
  @@map("notifications")
}

model AutomationRule {
  id          String            @id @default(uuid()) @db.Uuid
  tenantId    String            @map("tenant_id") @db.Uuid
  name        String
  isActive    Boolean           @default(true) @map("is_active")
  trigger     AutomationTrigger
  conditions  Json              @default("{}")
  actions     Json              @default("[]")
  createdById String?           @map("created_by_id") @db.Uuid
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  runs        AutomationRun[]

  @@index([tenantId, trigger, isActive])
  @@map("automation_rules")
}

model AutomationRun {
  id        String         @id @default(uuid()) @db.Uuid
  tenantId  String         @map("tenant_id") @db.Uuid
  ruleId    String         @map("rule_id") @db.Uuid
  rule      AutomationRule @relation(fields: [ruleId], references: [id])
  event     String
  entityId  String?        @map("entity_id") @db.Uuid
  status    String
  result    Json           @default("{}")
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([tenantId, ruleId, createdAt(sort: Desc)])
  @@map("automation_runs")
}

model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  /// Null for platform-level actions.
  tenantId       String?  @map("tenant_id") @db.Uuid
  tenant         Tenant?  @relation(fields: [tenantId], references: [id])
  userId         String?  @map("user_id") @db.Uuid
  action         String
  entityType     String   @map("entity_type")
  entityId       String?  @map("entity_id")
  oldValue       Json?    @map("old_value")
  newValue       Json?    @map("new_value")
  ip             String?
  userAgent      String?  @map("user_agent")
  impersonatedBy String?  @map("impersonated_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([tenantId, entityType, entityId, createdAt(sort: Desc)])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("audit_logs")
}
