# Production settings for deploy/docker-compose.prod.yml. Copy to deploy/.env.production and fill in.
# That file holds secrets: it is git-ignored, never baked into the image, and should be readable only
# by the user that runs Docker (chmod 600). Keep a copy of SESSION_SECRET and ENCRYPTION_KEY somewhere
# safe and apart from the database backups: MFA secrets cannot be read without ENCRYPTION_KEY.
#
# Generate every secret with:   openssl rand -hex 24      (passwords)
#                               openssl rand -base64 32   (SESSION_SECRET, ENCRYPTION_KEY)
# Passwords must use only letters, digits, "_" and "-" (they go into connection URLs).

# ── The site ─────────────────────────────────────────────────────────────────────────────────────
# The public host name, no scheme. Its DNS A/AAAA record must already point at this server, and
# ports 80 and 443 must be open, or the certificate cannot be issued.
APP_HOST=cms.example.com
# Where Let's Encrypt writes about the certificate (expiry warnings).
ACME_EMAIL=ops@example.com

# ── Secrets (all required) ───────────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=
AVN_APP_PASSWORD=
REDIS_PASSWORD=
SESSION_SECRET=
ENCRYPTION_KEY=

# ── Security ─────────────────────────────────────────────────────────────────────────────────────
# Caddy is the one proxy in front of the app. Change only if you add a CDN or load balancer before it.
TRUSTED_PROXY_HOPS=1
# Roles that must turn on two-step verification before they can use the app.
MFA_REQUIRED_ROLES=SUPER_ADMIN,TENANT_ADMIN
# 24+ characters turns on GET /api/metrics (Prometheus) for "Authorization: Bearer <token>". Empty: off.
METRICS_TOKEN=

# ── Documents (Cloudflare R2). Leave all four empty and the documents vault is switched off ────────
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# ── Email for invitations and password resets. Empty: the admin is shown a one-time link instead ──
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM="aVn CMS <no-reply@cms.example.com>"

# ── Optional ─────────────────────────────────────────────────────────────────────────────────────
# SESSION_TTL_HOURS=168
# ACCESS_LOG=errors
# AVN_VERSION=latest        # tag the image (for example a git commit) to keep the previous one for rollback
# HTTP_PORT=80
# HTTPS_PORT=443
